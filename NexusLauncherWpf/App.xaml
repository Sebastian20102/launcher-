<Application x:Class="NexusLauncherWpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:NexusLauncherWpf.Helpers"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <helpers:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <helpers:ViewVisibilityConverter x:Key="ViewVisibility" />
            <helpers:ColorStringToColorConverter x:Key="ColorStringToColor" />
            <helpers:LauncherArtworkConverter x:Key="LauncherArtwork" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
