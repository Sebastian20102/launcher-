<Window x:Class="NexusLauncherWpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:NexusLauncherWpf.Models"
        Title="Nexus Launcher"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate x:Key="LauncherCardTemplate">
            <Border x:Name="CardRoot"
                    Width="{DynamicResource LauncherCardWidth}"
                    MinHeight="{DynamicResource LauncherCardMinHeight}"
                    Style="{StaticResource Card}"
                    Margin="{DynamicResource LauncherCardGap}"
                    RenderTransformOrigin="0.5,0.5"
                    MouseEnter="LauncherCard_MouseEnter"
                    MouseMove="LauncherCard_MouseMove"
                    MouseLeave="LauncherCard_MouseLeave">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}" />
                </Border.InputBindings>
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform />
                        <RotateTransform />
                        <TranslateTransform />
                    </TransformGroup>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="124" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border CornerRadius="12" Grid.Row="0" ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{Binding CoverStart, Converter={StaticResource ColorStringToColor}}" Offset="0" />
                                <GradientStop Color="#11151C" Offset=".56" />
                                <GradientStop Color="{Binding CoverEnd, Converter={StaticResource ColorStringToColor}}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid Margin="14">
                            <Button Width="74"
                                    Height="74"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Padding="0"
                                    ToolTip="Abrir info rapida"
                                    Command="{Binding DataContext.ToggleCardInfoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Image Source="{Binding Item, Converter={StaticResource LauncherArtwork}}" Stretch="Uniform" Margin="12" Opacity=".92" />
                            </Button>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#22111318" BorderBrush="#33F2F1EC" BorderThickness="1" CornerRadius="8" Padding="8,3">
                                <TextBlock Text="{Binding Category}" Foreground="#DAD6CB" FontSize="10" FontWeight="Black" Opacity=".82" />
                            </Border>
                            <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="Black" TextWrapping="Wrap" VerticalAlignment="Bottom" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="0,14,0,0">
                        <Border HorizontalAlignment="Left" Background="{StaticResource Surface3Brush}" CornerRadius="9" Padding="8,4">
                            <TextBlock Text="{Binding Category}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Black" />
                        </Border>
                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,10" MaxHeight="42" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding LastOpenedText}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            <Border Grid.Column="1" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="7,3">
                                <TextBlock Text="{Binding PathStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <Grid x:Name="CardActions" Margin="0,14,0,0" Opacity=".42">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="46" />
                            </Grid.ColumnDefinitions>
                            <Button Content="Abrir"
                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,8,0" />
                            <Button Grid.Column="1"
                                    Content="{Binding FavoriteGlyph}"
                                    Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource IconButton}" />
                            <Button Grid.Column="2"
                                    Content="i"
                                    Command="{Binding DataContext.ToggleCardInfoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource IconButton}" />
                            <Button Grid.Column="3"
                                    Content="X"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource DangerButton}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="CardActions" Property="Opacity" Value="1" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="CompactRowTemplate">
            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}" />
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource Surface3Brush}">
                        <Grid>
                            <TextBlock Text="{Binding CategoryGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Black" Foreground="{StaticResource AccentBrush}" FontSize="10" Opacity=".45" />
                            <Image Source="{Binding Item, Converter={StaticResource LauncherArtwork}, ConverterParameter=Icon}" Stretch="Uniform" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="{Binding Path}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding OpenCountText}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                    <Button Grid.Column="3"
                            Content="Editar"
                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Margin="0,0,8,0" />
                    <Button Grid.Column="4"
                            Content="Eliminar"
                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Margin="0,0,8,0" />
                    <Button Grid.Column="5"
                            Content="Abrir"
                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource PrimaryButton}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="LibraryRailTemplate">
            <Border Padding="8"
                    Margin="0,0,0,4"
                    CornerRadius="8"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="1">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}" />
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource Surface3Brush}">
                        <Image Source="{Binding Item, Converter={StaticResource LauncherArtwork}, ConverterParameter=Icon}" Stretch="Uniform" Margin="5" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Category}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CommandPaletteTemplate">
            <Border Padding="12" Margin="0,0,0,8" CornerRadius="10" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}" />
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="92" />
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding Item, Converter={StaticResource LauncherArtwork}, ConverterParameter=Icon}" Stretch="Uniform" Width="32" Height="32" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding LaunchMeta}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding PathStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ActivityTemplate">
            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="88" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm}}" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="8,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Level}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Black" HorizontalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="22,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#141821" Offset="0" />
                    <GradientStop Color="#0E1117" Offset=".55" />
                    <GradientStop Color="#171818" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="NEXUS" FontSize="26" FontWeight="Black" />
                    <TextBlock Text="Command Deck" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" />
                </StackPanel>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden" Margin="8,0,18,0">
                    <ItemsControl ItemsSource="{Binding NavigationItems}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource NavPillButton}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Ctrl+K" Command="{Binding OpenCommandPaletteCommand}" Margin="0,0,10,0" />
                    <Button Content="Perfil rapido" Command="{Binding GamingModeCommand}" Margin="0,0,10,0" />
                    <Button Content="+ Acceso" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,18,28,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="440" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="LAUNCHER PERSONAL" Style="{StaticResource EyebrowText}" />
                    <TextBlock Text="{Binding PageTitle}" FontSize="42" FontWeight="Black" />
                </StackPanel>
                <TextBox Grid.Column="1"
                         x:Name="SearchBox"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center"
                         ToolTip="Buscador global"
                         Margin="16,0"
                         Tag="Buscar" />
                <Button Grid.Column="2" Content="Validar" Command="{Binding ValidateLibraryCommand}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Grid.Column="3" Content="Detectar" Command="{Binding DiscoverAppsCommand}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Grid.Column="4" Content="+ Acceso" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <StackPanel Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibility}, ConverterParameter=Inicio}">
                        <Border Style="{StaticResource Card}" Padding="0" MinHeight="320">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.05*" />
                                    <ColumnDefinition Width=".95*" />
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="14,0,0,14">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#24262B" Offset="0" />
                                            <GradientStop Color="#101319" Offset=".50" />
                                            <GradientStop Color="#6F6654" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel VerticalAlignment="Bottom" Margin="28">
                                        <TextBlock Text="ACCESO DESTACADO" Style="{StaticResource EyebrowText}" />
                                        <TextBlock Text="{Binding FeaturedItem.Name}" FontSize="58" FontWeight="Black" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding FeaturedItem.Description}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,18" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Abrir ahora" Command="{Binding OpenCommand}" CommandParameter="{Binding FeaturedItem}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" />
                                            <Button Content="Favorito" Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding FeaturedItem}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <UniformGrid Grid.Column="1" Columns="2" Margin="18">
                                    <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                                        <StackPanel>
                                            <TextBlock Text="COLECCION" Style="{StaticResource EyebrowText}" />
                                            <TextBlock Text="Favoritos" Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock Text="{Binding FavoriteCount}" FontSize="36" FontWeight="Black" />
                                            <Button Content="Ver" Command="{Binding OpenCategoryCommand}" CommandParameter="Favoritos" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="COLECCION" Style="{StaticResource EyebrowText}" />
                                            <TextBlock Text="Juegos" Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock Text="{Binding GameCount}" FontSize="36" FontWeight="Black" />
                                            <Button Content="Abrir" Command="{Binding OpenCategoryCommand}" CommandParameter="Juegos" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="ESTADO" Style="{StaticResource EyebrowText}" />
                                            <TextBlock Text="Revision" Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock Text="{Binding InvalidCount}" FontSize="36" FontWeight="Black" />
                                            <Button Content="Reparar" Command="{Binding OpenCategoryCommand}" CommandParameter="Revision" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="SHELF" Style="{StaticResource EyebrowText}" />
                                            <TextBlock Text="Perfil rapido" Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock Text="{Binding ProfileCount}" FontSize="36" FontWeight="Black" />
                                            <Button Content="Lanzar" Command="{Binding GamingModeCommand}" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <TextBlock Text="Favoritos" Style="{StaticResource SectionTitleText}" Margin="0,8,0,12" />
                        <ItemsControl ItemsSource="{Binding FavoriteItems}" ItemTemplate="{StaticResource LauncherCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <TextBlock Text="Recientes" Style="{StaticResource SectionTitleText}" Margin="0,8,0,12" />
                        <ItemsControl ItemsSource="{Binding RecentItems}" ItemTemplate="{StaticResource CompactRowTemplate}" />

                        <TextBlock Text="Actividad" Style="{StaticResource SectionTitleText}" Margin="0,8,0,12" />
                        <ItemsControl ItemsSource="{Binding ActivityItems}" ItemTemplate="{StaticResource ActivityTemplate}" />
                    </StackPanel>

                    <Grid Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibility}, ConverterParameter=Biblioteca}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,18,0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock Text="COLECCION" Style="{StaticResource EyebrowText}" />
                                    <TextBlock Text="{Binding PageSummary}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding LibraryRailItems}" ItemTemplate="{StaticResource LibraryRailTemplate}" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="0,0,18,0">
                            <DockPanel Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox Width="220" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" />
                                    <Button Content="Validar rutas" Command="{Binding ValidateLibraryCommand}" Margin="10,0,0,0" />
                                    <Button Content="Detectar apps" Command="{Binding DiscoverAppsCommand}" Margin="10,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="Capsulas de biblioteca" FontSize="20" FontWeight="Bold" DockPanel.Dock="Right" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,14">
                                <TextBlock Text="{Binding PageSummary}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Anterior" Command="{Binding PreviousPageCommand}" Width="110" Margin="0,0,8,0" />
                                    <Button Content="Siguiente" Command="{Binding NextPageCommand}" Width="110" />
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding PagedItems}" ItemTemplate="{StaticResource LauncherCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>

                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="150" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border CornerRadius="12,12,0,0" ClipToBounds="True">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#262B35" Offset="0" />
                                            <GradientStop Color="#14171D" Offset=".58" />
                                            <GradientStop Color="#75684C" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <Image Source="{Binding SelectedItem.Item, Converter={StaticResource LauncherArtwork}}" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" Width="86" Height="86" Margin="0,0,22,0" Opacity=".8" />
                                        <StackPanel VerticalAlignment="Bottom" Margin="20">
                                            <TextBlock Text="PAGINA DEL ACCESO" Style="{StaticResource EyebrowText}" />
                                            <TextBlock Text="{Binding SelectedItemTitle}" FontSize="30" FontWeight="Black" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="20">
                                    <Border HorizontalAlignment="Left" Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="9,5" Margin="0,0,0,12">
                                        <TextBlock Text="{Binding SelectedItemStatus}" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Black" />
                                    </Border>
                                    <TextBlock Text="{Binding SelectedItemDescription}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                    <TextBlock Text="{Binding SelectedItemMeta}" FontWeight="Bold" Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding SelectedItemPath}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,18" />
                                    <Button Content="Abrir" Command="{Binding OpenCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" />
                                    <Button Content="Abrir ubicacion" Command="{Binding OpenLocationCommand}" Margin="0,0,0,8" />
                                    <Button Content="Editar arte y ruta" Command="{Binding EditCommand}" Margin="0,0,0,8" />
                                    <Button Content="Duplicar acceso" Command="{Binding DuplicateCommand}" Margin="0,0,0,8" />
                                    <Button Content="Eliminar" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Width="Auto" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibility}, ConverterParameter=Favoritos}">
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock Text="{Binding PageSummary}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Anterior" Command="{Binding PreviousPageCommand}" Width="110" Margin="0,0,8,0" />
                                <Button Content="Siguiente" Command="{Binding NextPageCommand}" Width="110" />
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding PagedItems}" ItemTemplate="{StaticResource LauncherCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibility}, ConverterParameter=Recientes}">
                        <ItemsControl ItemsSource="{Binding RecentItems}" ItemTemplate="{StaticResource CompactRowTemplate}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibility}, ConverterParameter=Herramientas}">
                        <TextBlock Text="Herramientas de desarrollo, IA y utilidades" FontSize="24" FontWeight="Black" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding ToolItems}" ItemTemplate="{StaticResource CompactRowTemplate}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibility}, ConverterParameter=Actividad}">
                        <DockPanel Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Registro de actividad" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="Aperturas, errores, backups, imports, exports y detecciones recientes." Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="Abrir datos" Command="{Binding OpenDataFolderCommand}" Width="150" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding ActivityItems}" ItemTemplate="{StaticResource ActivityTemplate}" />
                    </StackPanel>

                    <Grid Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibility}, ConverterParameter=Design Lab}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="420" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,18,0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="DESIGN SYSTEM" Style="{StaticResource EyebrowText}" />
                                    <TextBlock Text="Control manual del launcher" FontSize="28" FontWeight="Black" Margin="0,4,0,8" />
                                    <TextBlock Text="Edita estos tokens y aplica el tema sin recompilar. Tambien puedes abrir theme.json y tocarlo a mano." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,18" />

                                    <TextBlock Text="Nombre" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox Text="{Binding ThemeName, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Fondo" Foreground="{StaticResource MutedBrush}" />
                                            <TextBox Text="{Binding ThemeBackground, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />
                                            <TextBlock Text="Superficie" Foreground="{StaticResource MutedBrush}" />
                                            <TextBox Text="{Binding ThemeSurface, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />
                                            <TextBlock Text="Texto" Foreground="{StaticResource MutedBrush}" />
                                            <TextBox Text="{Binding ThemeText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Acento" Foreground="{StaticResource MutedBrush}" />
                                            <TextBox Text="{Binding ThemeAccent, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />
                                            <TextBlock Text="Acento 2" Foreground="{StaticResource MutedBrush}" />
                                            <TextBox Text="{Binding ThemeAccent2, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />
                                            <TextBlock Text="Texto suave" Foreground="{StaticResource MutedBrush}" />
                                            <TextBox Text="{Binding ThemeMuted, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Densidad" Foreground="{StaticResource MutedBrush}" />
                                    <ComboBox ItemsSource="{Binding ThemeDensities}" SelectedItem="{Binding ThemeDensity}" Margin="0,6,0,12" />
                                    <CheckBox Content="Animaciones activas" IsChecked="{Binding ThemeAnimations}" Margin="0,0,0,16" />

                                    <Button Content="Aplicar tema" Command="{Binding ApplyThemeCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" />
                                    <Button Content="Abrir theme.json" Command="{Binding OpenThemeFolderCommand}" Margin="0,0,0,8" />
                                    <Button Content="Restaurar Nexus Gold" Command="{Binding ResetThemeCommand}" Margin="0,0,0,8" />
                                    <Button Content="Preset Slate Glass" Command="{Binding SlateThemeCommand}" Margin="0,0,0,8" />
                                    <Button Content="Preset Ember Black" Command="{Binding EmberThemeCommand}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Preview vivo" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12" />
                            <Border Style="{StaticResource Card}" Padding="0" MinHeight="280">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width=".8*" />
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="12,0,0,12">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="{DynamicResource ColorSurface3}" Offset="0" />
                                                <GradientStop Color="{DynamicResource ColorBg}" Offset=".56" />
                                                <GradientStop Color="{DynamicResource ColorAccent}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel VerticalAlignment="Bottom" Margin="28">
                                            <TextBlock Text="NEXUS STYLE PREVIEW" Style="{StaticResource EyebrowText}" />
                                            <TextBlock Text="Tu launcher, tu direccion visual" FontSize="42" FontWeight="Black" TextWrapping="Wrap" />
                                            <TextBlock Text="Si esto no se siente como producto, cambiamos tokens, densidad y componentes hasta que la base tenga identidad." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,18" />
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Accion primaria" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" />
                                                <Button Content="Secundaria" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="18">
                                        <Border Width="{DynamicResource LauncherCardWidth}" MinHeight="{DynamicResource LauncherCardMinHeight}" Style="{StaticResource Card}" Margin="0">
                                            <StackPanel>
                                                <Border Height="118" CornerRadius="12">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="{DynamicResource ColorSurface2}" Offset="0" />
                                                            <GradientStop Color="{DynamicResource ColorAccent}" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <TextBlock Text="GAME" Margin="14" FontWeight="Black" Foreground="{StaticResource TextBrush}" />
                                                </Border>
                                                <TextBlock Text="Tarjeta de ejemplo" FontSize="22" FontWeight="Black" Margin="0,14,0,4" />
                                                <TextBlock Text="Vista previa de densidad, color, botones y contraste." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                                <Button Content="Abrir" Style="{StaticResource PrimaryButton}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibility}, ConverterParameter=Revision}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,18,0">
                            <DockPanel Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Accesos que necesitan atencion" Style="{StaticResource SectionTitleText}" />
                                    <TextBlock Text="Rutas locales inexistentes, URLs invalidas o comandos incompletos." Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Content="Validar otra vez" Command="{Binding ValidateLibraryCommand}" Width="160" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding InvalidItems}" ItemTemplate="{StaticResource CompactRowTemplate}" />
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="REPARACION" Style="{StaticResource EyebrowText}" />
                                <Image Source="{Binding SelectedItem.Item, Converter={StaticResource LauncherArtwork}}" Stretch="Uniform" Width="70" Height="70" HorizontalAlignment="Left" Margin="0,12,0,8" />
                                <TextBlock Text="{Binding SelectedItemTitle}" FontSize="28" FontWeight="Black" TextWrapping="Wrap" Margin="0,4,0,10" />
                                <TextBlock Text="{Binding SelectedItemPath}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,18" />
                                <Button Content="Editar ruta" Command="{Binding EditCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" />
                                <Button Content="Abrir ubicacion" Command="{Binding OpenLocationCommand}" Margin="0,0,0,8" />
                                <Button Content="Duplicar antes de reparar" Command="{Binding DuplicateCommand}" Margin="0,0,0,8" />
                                <Button Content="Eliminar acceso" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Width="Auto" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Visibility="{Binding CurrentView, Converter={StaticResource ViewVisibility}, ConverterParameter=Ajustes}">
                        <UniformGrid Columns="3">
                            <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                                <StackPanel>
                                    <TextBlock Text="Datos" FontSize="22" FontWeight="Black" />
                                    <TextBlock Text="Guardar, exportar y abrir tu configuracion local." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,14" />
                                    <Button Content="Guardar" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" />
                                    <Button Content="Exportar JSON" Command="{Binding ExportCommand}" Margin="0,0,0,8" />
                                    <Button Content="Importar JSON" Command="{Binding ImportCommand}" Margin="0,0,0,8" />
                                    <Button Content="Crear backup" Command="{Binding CreateBackupCommand}" Margin="0,0,0,8" />
                                    <Button Content="Detectar apps de Windows" Command="{Binding DiscoverAppsCommand}" Margin="0,0,0,8" />
                                    <Button Content="Abrir carpeta de datos" Command="{Binding OpenDataFolderCommand}" Margin="0,0,0,8" />
                                    <Button Content="Abrir backups" Command="{Binding OpenBackupFolderCommand}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                                <StackPanel>
                                    <TextBlock Text="Tema" FontSize="22" FontWeight="Black" />
                                    <TextBlock Text="Paleta sobria con acentos discretos y tarjetas dinamicas por categoria." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,14" />
                                    <Button Content="Validar biblioteca" Command="{Binding ValidateLibraryCommand}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Accesos" FontSize="22" FontWeight="Black" />
                                    <TextBlock Text="Agregar, editar y eliminar accesos." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,14" />
                                    <Button Content="Agregar acceso" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Perfil rapido" FontSize="24" FontWeight="Black" />
                                        <TextBlock Text="Estos accesos se abren juntos cuando activas el grupo." Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right"
                                            Content="Abrir grupo"
                                            Command="{Binding GamingModeCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            Width="180" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding GamingModeItems}" ItemTemplate="{StaticResource CompactRowTemplate}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,14,0,0">
                <DockPanel>
                    <TextBlock Text="Acciones rapidas" Style="{StaticResource EyebrowText}" DockPanel.Dock="Left" Margin="0,0,16,0" />
                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="Ctrl+F buscar   Ctrl+N agregar   Enter abrir   Ctrl+E editar   F5 validar   Esc limpiar" />
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Width="380"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Margin="0,18,28,86"
                Padding="20"
                CornerRadius="14"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1"
                Panel.ZIndex="25"
                Visibility="{Binding IsInspectorVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,16">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="INFO RAPIDA" Style="{StaticResource EyebrowText}" />
                        <TextBlock Text="{Binding SelectedItemTitle}" FontSize="28" FontWeight="Black" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right"
                            Content="X"
                            Width="38"
                            Height="34"
                            MinHeight="34"
                            Padding="0"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding ToggleCardInfoCommand}"
                            CommandParameter="{Binding SelectedItem}" />
                </DockPanel>

                <StackPanel Grid.Row="1">
                    <Border Height="112" CornerRadius="12" Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,0,14">
                        <Image Source="{Binding SelectedItem.Item, Converter={StaticResource LauncherArtwork}}" Stretch="Uniform" Width="82" Height="82" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border HorizontalAlignment="Left" Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="9,5" Margin="0,0,0,12">
                        <TextBlock Text="{Binding SelectedItemStatus}" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Black" />
                    </Border>
                    <TextBlock Text="{Binding SelectedItemMeta}" FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding SelectedItemDescription}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                    <TextBlock Text="{Binding SelectedItemPath}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Content="Abrir" Command="{Binding OpenCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" />
                    <Button Content="Abrir ubicacion" Command="{Binding OpenLocationCommand}" Margin="0,0,0,8" />
                    <Button Content="Editar" Command="{Binding EditCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.RowSpan="2"
              Background="#AA080A0D"
              Panel.ZIndex="50"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <Border Width="380"
                    Padding="24"
                    CornerRadius="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="NEXUS" Style="{StaticResource EyebrowText}" />
                    <TextBlock Text="{Binding BusyMessage}" FontSize="28" FontWeight="Black" TextWrapping="Wrap" Margin="0,6,0,14" />
                    <ProgressBar IsIndeterminate="True" Height="8" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="2"
              Background="#B0080A0D"
              Panel.ZIndex="60"
              Visibility="{Binding IsCommandPaletteOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Width="720"
                    MaxHeight="620"
                    Padding="18"
                    CornerRadius="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,86,0,0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="COMMAND PALETTE" Style="{StaticResource EyebrowText}" />
                            <TextBlock Text="Busca y abre cualquier acceso" FontSize="24" FontWeight="Black" />
                        </StackPanel>
                        <Button DockPanel.Dock="Right"
                                Content="Esc"
                                Command="{Binding CloseCommandPaletteCommand}"
                                Width="64" />
                    </DockPanel>
                    <TextBox x:Name="CommandPaletteBox"
                             Text="{Binding CommandQuery, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Buscar acceso, carpeta o programa"
                             Margin="0,0,0,14" />
                    <ItemsControl ItemsSource="{Binding CommandPaletteItems}" ItemTemplate="{StaticResource CommandPaletteTemplate}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,28,28"
                Padding="16,12"
                CornerRadius="12"
                Background="{StaticResource Surface3Brush}"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ToastMessage}" FontWeight="SemiBold" />
        </Border>
    </Grid>
</Window>
