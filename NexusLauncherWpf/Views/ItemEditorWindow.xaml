<Window x:Class="NexusLauncherWpf.Views.ItemEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acceso"
        Width="720"
        Height="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Background="{StaticResource BgBrush}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="74" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="54" Height="54" CornerRadius="12" Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <Grid>
                        <TextBlock Text="APP" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Black" Foreground="{StaticResource AccentBrush}" Opacity=".35" />
                        <Image Source="{Binding Item, Converter={StaticResource LauncherArtwork}, ConverterParameter=Icon}" Stretch="Uniform" Width="34" Height="34" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="ACCESO" Style="{StaticResource EyebrowText}" />
                    <TextBlock Text="{Binding TitleText, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="30" FontWeight="Black" />
                    <TextBlock Text="Define como se ve y como se abre dentro de tu launcher." Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="IDENTIDAD" Style="{StaticResource EyebrowText}" />
                    <TextBlock Text="Nombre" Style="{StaticResource MutedText}" Margin="0,14,0,0" />
                    <TextBox x:Name="NameBox" Margin="0,6,0,14" />
                    <TextBlock Text="Descripcion" Style="{StaticResource MutedText}" />
                    <TextBox x:Name="DescriptionBox" Margin="0,6,0,18" />

                    <TextBlock Text="VISUALES" Style="{StaticResource EyebrowText}" />
                    <TextBlock Text="Icono personalizado" Style="{StaticResource MutedText}" Margin="0,14,0,0" />
                    <Grid Margin="0,6,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="118" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="IconPathBox" />
                        <Button Grid.Column="1" Content="Elegir" Click="BrowseIcon_Click" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Text="Portada personalizada" Style="{StaticResource MutedText}" />
                    <Grid Margin="0,6,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="118" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CoverPathBox" />
                        <Button Grid.Column="1" Content="Elegir" Click="BrowseCover_Click" Margin="8,0,0,0" />
                    </Grid>
                    <Button Content="Limpiar visuales personalizados" Click="ClearVisuals_Click" Margin="0,0,0,18" HorizontalAlignment="Left" />

                    <TextBlock Text="LANZAMIENTO" Style="{StaticResource EyebrowText}" />
                    <TextBlock Text="Ruta, URL o comando" Style="{StaticResource MutedText}" Margin="0,14,0,0" />
                    <Grid Margin="0,6,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="118" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PathBox" />
                        <Button Grid.Column="1" Content="Programa" Click="BrowseFile_Click" Margin="8,0,0,0" />
                        <Button Grid.Column="2" Content="Carpeta" Click="BrowseFolder_Click" Margin="8,0,0,0" />
                    </Grid>
                    <Button Content="Usar URL de ejemplo" Click="UseUrl_Click" Margin="0,0,0,14" HorizontalAlignment="Left" />
                    <TextBlock Text="Argumentos" Style="{StaticResource MutedText}" />
                    <TextBox x:Name="ArgumentsBox" Margin="0,6,0,18" />

                    <TextBlock Text="ORGANIZACION" Style="{StaticResource EyebrowText}" />
                    <Grid Margin="0,14,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Tipo" Style="{StaticResource MutedText}" />
                            <ComboBox x:Name="TypeBox" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Categoria" Style="{StaticResource MutedText}" />
                            <ComboBox x:Name="CategoryBox" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                    <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                        <StackPanel>
                            <CheckBox x:Name="FavoriteBox" Content="Marcar como favorito" />
                            <CheckBox x:Name="GamingModeBox" Content="Incluir en perfil rapido" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" IsCancel="True" Margin="0,0,10,0" />
            <Button Content="Guardar" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
