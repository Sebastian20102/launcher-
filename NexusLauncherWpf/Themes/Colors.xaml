<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="ColorBg">#090A0D</Color>
    <Color x:Key="ColorSurface">#12151B</Color>
    <Color x:Key="ColorSurface2">#1A1F28</Color>
    <Color x:Key="ColorSurface3">#232A35</Color>
    <Color x:Key="ColorLine">#303846</Color>
    <Color x:Key="ColorText">#F2F1EC</Color>
    <Color x:Key="ColorMuted">#A7A39A</Color>
    <Color x:Key="ColorAccent">#C8A96A</Color>
    <Color x:Key="ColorAccent2">#8F9C8A</Color>
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource ColorBg}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource ColorSurface2}" />
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource ColorSurface3}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource ColorLine}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource ColorText}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource ColorMuted}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource ColorAccent2}" />
    <sys:Double x:Key="LauncherCardWidth" xmlns:sys="clr-namespace:System;assembly=mscorlib">264</sys:Double>
    <sys:Double x:Key="LauncherCardMinHeight" xmlns:sys="clr-namespace:System;assembly=mscorlib">286</sys:Double>
    <Thickness x:Key="LauncherCardGap">0,0,18,18</Thickness>
</ResourceDictionary>
